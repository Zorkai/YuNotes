<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YuNotes.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YuNotes.Controls"
    Background="{ThemeResource AppBackgroundBrush}">

    <!-- Control Center layout: quick tiles for the switches people flip often,
         an Updates card with a progress ring and stage track, then one Expander
         per area for the detailed settings. A search box filters all three, and
         a save bar slides in only when something changed. -->
    <Page.Resources>
        <DataTemplate x:Key="ToolItemTemplate">
            <Grid ColumnSpacing="12" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="18"
                          FontFamily="{StaticResource MaterialIconsFamily}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}"
                           VerticalAlignment="Center"/>
                <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0"/>
            </Grid>
        </DataTemplate>

        <!-- Expanders blend with the app's cards instead of the default Fluent fill. -->
        <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="AppSurfaceBrush" />
        <StaticResource x:Key="ExpanderContentBackground" ResourceKey="AppSurfaceBrush" />
        <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="AppBorderBrush" />
        <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="AppBorderBrush" />

        <Style x:Key="SectionExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,16,20,20" />
        </Style>

        <!-- Quick-settings tile. Off: plain card, muted icon bubble, empty switch.
             On: soft accent fill and outline, solid accent bubble, filled switch.
             Text stays the primary color either way so it reads in both themes. -->
        <Style x:Key="SettingsTileStyle" TargetType="controls:SettingsTile">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SettingsTile">
                        <Grid x:Name="RootGrid">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border x:Name="OnLayer" Background="{ThemeResource AppAccentSoftBrush}"
                                    BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}" Opacity="0">
                                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.15" /></Border.OpacityTransition>
                            </Border>
                            <Border x:Name="HoverLayer" Background="{ThemeResource AppSurfaceVariantBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}" Opacity="0">
                                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.1" /></Border.OpacityTransition>
                            </Border>
                            <Grid Padding="{TemplateBinding Padding}" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="IconBubble" Width="36" Height="36" CornerRadius="18"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AppSurfaceVariantBrush}">
                                    <FontIcon x:Name="Icon" Glyph="{TemplateBinding Glyph}" FontSize="19"
                                              Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Border>
                                <!-- Little switch so the on/off state reads without color. -->
                                <Border x:Name="Pill" Width="30" Height="17" CornerRadius="8.5"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                                        BorderThickness="1" BorderBrush="{ThemeResource AppTextSecondaryBrush}"
                                        Background="Transparent">
                                    <Ellipse x:Name="Knob" Width="9" Height="9" Margin="3,0"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Fill="{ThemeResource AppTextSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="1">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      FontWeight="SemiBold"
                                                      Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock x:Name="CaptionText" Text="{TemplateBinding Caption}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverLayer.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverLayer.Opacity" Value="0.9" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="OnLayer.Opacity" Value="1" />
                                            <Setter Target="IconBubble.Background" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Icon.Foreground" Value="White" />
                                            <Setter Target="Pill.Background" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Pill.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                            <Setter Target="Knob.Fill" Value="White" />
                                            <Setter Target="CaptionText.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="OnLayer.Opacity" Value="1" />
                                            <Setter Target="HoverLayer.Opacity" Value="0.35" />
                                            <Setter Target="IconBubble.Background" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Icon.Foreground" Value="White" />
                                            <Setter Target="Pill.Background" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Pill.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                            <Setter Target="Knob.Fill" Value="White" />
                                            <Setter Target="CaptionText.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="OnLayer.Opacity" Value="1" />
                                            <Setter Target="HoverLayer.Opacity" Value="0.6" />
                                            <Setter Target="IconBubble.Background" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Icon.Foreground" Value="White" />
                                            <Setter Target="Pill.Background" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Pill.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                            <Setter Target="Knob.Fill" Value="White" />
                                            <Setter Target="CaptionText.Foreground" Value="{ThemeResource AppAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="OnLayer.Opacity" Value="1" />
                                            <Setter Target="RootGrid.Opacity" Value="0.45" />
                                            <Setter Target="IconBubble.Background" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Icon.Foreground" Value="White" />
                                            <Setter Target="Pill.Background" Value="{ThemeResource AppAccentBrush}" />
                                            <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                            <Setter Target="Knob.Fill" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepBarStyle" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="100" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="Background" Value="{ThemeResource AppBorderBrush}" />
        </Style>
        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        </Style>
        <Style x:Key="RowHintStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedStyle}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SubheadStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 48 = Tall caption-button band height, so the header buttons share
                 a centerline with minimize/maximize/close. -->
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderGrid" Padding="12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button x:Name="BackBtn" Style="{StaticResource ToolButtonStyle}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xe5c4;" />
                    </Button>
                    <TextBlock Text="Settings" Style="{StaticResource H2Style}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Window drag region. SetTitleBar turns this element's bounds into
                     non-client space (controls overlapping it lose input), so it only
                     covers the empty middle column. -->
                <Border x:Name="HeaderDragRegion" Grid.Column="1" Background="Transparent" Margin="0,-6" />
                <AutoSuggestBox x:Name="SettingsSearch" Grid.Column="2" Width="280"
                                PlaceholderText="Search settings (Ctrl+F)" QueryIcon="Find"
                                VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="RootScroller" Grid.Row="1" Padding="32,24,32,40">
            <StackPanel x:Name="RootStack" Spacing="14" HorizontalAlignment="Center">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- ─── Quick tiles ───────────────────────────────────────────── -->
                <Grid x:Name="TileGrid" ColumnSpacing="10" RowSpacing="10">
                    <controls:SettingsTile x:Name="PressureEnabledBox" Style="{StaticResource SettingsTileStyle}" Glyph="&#xe746;" Content="Pressure"
                                          ToolTipService.ToolTip="Vary stroke width with pen pressure" />
                    <controls:SettingsTile x:Name="PalmToggle" Style="{StaticResource SettingsTileStyle}" Glyph="&#xe764;" Content="Palm rejection"
                                          ToolTipService.ToolTip="Ignore your hand resting on the screen while writing" />
                    <controls:SettingsTile x:Name="HoldToSnapToggle" Style="{StaticResource SettingsTileStyle}" Glyph="&#xe7c8;" Content="Hold to snap"
                                          ToolTipService.ToolTip="Draw a shape, then hold still for about 750 ms to snap it to a perfect line, ellipse or rectangle" />
                    <controls:SettingsTile x:Name="AutosaveToggle" Style="{StaticResource SettingsTileStyle}" Glyph="&#xe161;" Content="Autosave"
                                          ToolTipService.ToolTip="Save automatically a short while after you stop drawing" />
                    <controls:SettingsTile x:Name="AutoUpdateToggle" Style="{StaticResource SettingsTileStyle}" Glyph="&#xe8d7;" Content="Auto-update"
                                          ToolTipService.ToolTip="Download updates in the background and install them when you close YuNotes" />
                    <controls:SettingsTile x:Name="LiquidGlassBox" Style="{StaticResource SettingsTileStyle}" Glyph="&#xe798;" Content="Liquid glass"
                                          ToolTipService.ToolTip="Render the floating toolbar as refractive glass. Turn off to fall back to plain acrylic" />
                    <controls:SettingsTile x:Name="SeamlessPagesBox" Style="{StaticResource SettingsTileStyle}" Glyph="&#xe8ed;" Content="Seamless pages"
                                          ToolTipService.ToolTip="No gap between pages" />
                    <controls:SettingsTile x:Name="HideZoomBarBox" Style="{StaticResource SettingsTileStyle}" Glyph="&#xe8ff;" Content="Hide zoom bar"
                                          ToolTipService.ToolTip="Hide the zoom bar in the editor" />
                </Grid>

                <!-- ─── Updates ──────────────────────────────────────────────── -->
                <Border x:Name="UpdatesCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,6,0,6">
                    <Grid ColumnSpacing="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="88" Height="88" VerticalAlignment="Center">
                            <ProgressRing x:Name="UpdateRing" Width="88" Height="88"
                                          IsIndeterminate="False" IsActive="True"
                                          Minimum="0" Maximum="100" Value="0"
                                          Foreground="{ThemeResource AppAccentBrush}"
                                          Background="{ThemeResource AppAccentSoftBrush}" />
                            <TextBlock x:Name="UpdatePercentText" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <FontIcon x:Name="UpdateStateIcon" Glyph="&#xe923;" FontSize="30"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AppAccentBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="UpdateTitleText" Text="Updates" FontSize="{StaticResource FontSizeSubheading}"
                                               FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="CheckUpdatesBtn" Grid.Column="1" Content="Check for updates"
                                        CornerRadius="8" VerticalAlignment="Top" />
                            </Grid>
                            <Grid x:Name="UpdateSteps" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <ProgressBar x:Name="StepCheckBar" Style="{StaticResource StepBarStyle}" />
                                    <TextBlock x:Name="StepCheckLabel" Text="Check" Style="{StaticResource StepLabelStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <ProgressBar x:Name="StepDownloadBar" Style="{StaticResource StepBarStyle}" />
                                    <TextBlock x:Name="StepDownloadLabel" Text="Download" Style="{StaticResource StepLabelStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <ProgressBar x:Name="StepStageBar" Style="{StaticResource StepBarStyle}" />
                                    <TextBlock x:Name="StepStageLabel" Text="Prepare" Style="{StaticResource StepLabelStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6">
                                    <ProgressBar x:Name="StepReadyBar" Style="{StaticResource StepBarStyle}" />
                                    <TextBlock x:Name="StepReadyLabel" Text="Ready" Style="{StaticResource StepLabelStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="UpdateMetaText" FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" Visibility="Collapsed" />
                            <TextBlock x:Name="AppVersionText" FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── Pen & stylus ─────────────────────────────────────────── -->
                <Expander x:Name="PenSection" Style="{StaticResource SectionExpanderStyle}"
                          Tag="pen stylus pressure sensitivity minimum multiplier barrel button eraser tip remap snap shape">
                    <Expander.Header>
                        <Grid ColumnSpacing="14" Padding="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xf604;" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Pen &amp; stylus" Style="{StaticResource SubheadStyle}" /><TextBlock x:Name="PenSummary" Text="Pressure curve, barrel button, test area" Style="{StaticResource RowHintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Minimum pressure" VerticalAlignment="Center"/>
                            <Slider x:Name="MinPressureSlider" Grid.Column="1" Minimum="0" Maximum="0.5" StepFrequency="0.01"/>
                            <TextBlock x:Name="MinPressureLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Pressure multiplier" VerticalAlignment="Center"/>
                            <Slider x:Name="PressureMultSlider" Grid.Row="1" Grid.Column="1" Minimum="0.25" Maximum="3.0" StepFrequency="0.05"/>
                            <TextBlock x:Name="PressureMultLabel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Turn pressure on with the Pressure tile above. If your stylus or Windows doesn't report pressure, these settings have no effect."
                                   Style="{StaticResource RowHintStyle}"/>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Test area: each sample is a circle sized to its pressure."
                                           Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                                <Button x:Name="PressureClearBtn" Content="Clear"
                                        HorizontalAlignment="Right" Padding="10,4" CornerRadius="8"/>
                            </Grid>
                            <Border x:Name="PressureSandbox"
                                    Background="{ThemeResource AppSurfaceVariantBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Height="180"
                                    IsHitTestVisible="True">
                                <Grid>
                                    <Canvas x:Name="PressureCanvas" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="PressureHint" Text="Draw here with your pen to preview pressure."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Background="{ThemeResource AppBorderBrush}" Height="1" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Barrel button" Style="{StaticResource SubheadStyle}" />
                                <TextBlock Text="Switches tool only while held. The eraser tip always erases with the current toolbar settings."
                                           Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="BarrelCombo" Grid.Column="1" Width="220" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ─── Palm rejection ──────────────────────────────────────── -->
                <Expander x:Name="PalmSection" Style="{StaticResource SectionExpanderStyle}"
                          Tag="palm rejection touch grace period hand">
                    <Expander.Header>
                        <Grid ColumnSpacing="14" Padding="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xe913;" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Palm rejection" Style="{StaticResource SubheadStyle}" /><TextBlock x:Name="PalmSummary" Text="Touch handling while the pen is in use" Style="{StaticResource RowHintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Ignore touch while pen is active" Style="{StaticResource SubheadStyle}" />
                                <TextBlock Text="Finger input is dropped as long as the pen is near the screen." Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="IgnoreTouchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Grace period (ms)" Style="{StaticResource SubheadStyle}" />
                                <TextBlock Text="How long touch stays blocked after the pen lifts." Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="GraceBox" Grid.Column="1" Width="140" Minimum="0" Maximum="3000"
                                       SpinButtonPlacementMode="Inline" Value="500" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ─── Colors & widths ─────────────────────────────────────── -->
                <Expander x:Name="InkSection" Style="{StaticResource SectionExpanderStyle}"
                          Tag="colors color preset palette pen highlighter eraser width default">
                    <Expander.Header>
                        <Grid ColumnSpacing="14" Padding="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xe3b7;" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Colors &amp; widths" Style="{StaticResource SubheadStyle}" /><TextBlock x:Name="InkSummary" Text="Preset colors and default tool widths" Style="{StaticResource RowHintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Preset colors" Style="{StaticResource SubheadStyle}" />
                                    <TextBlock Text="Shown in the toolbar flyout for each tool." Style="{StaticResource RowHintStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <RadioButton x:Name="ColorToolPen" Content="Pen" IsChecked="True" GroupName="ColorTool" MinWidth="0"/>
                                    <RadioButton x:Name="ColorToolHighlighter" Content="Highlighter" GroupName="ColorTool" MinWidth="0"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                                <StackPanel x:Name="ColorsPanel" Orientation="Horizontal" Spacing="8" Padding="2"/>
                            </ScrollViewer>
                        </StackPanel>

                        <Border Background="{ThemeResource AppBorderBrush}" Height="1" />

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Default pen width" Style="{StaticResource SubheadStyle}" VerticalAlignment="Center"/>
                            <NumberBox x:Name="PenWidthBox" Grid.Column="1" Width="140" Minimum="1" Maximum="40" Value="2.5" SpinButtonPlacementMode="Inline"/>
                            <TextBlock Grid.Row="1" Text="Default highlighter width" Style="{StaticResource SubheadStyle}" VerticalAlignment="Center"/>
                            <NumberBox x:Name="HighWidthBox" Grid.Row="1" Grid.Column="1" Width="140" Minimum="2" Maximum="60" Value="18" SpinButtonPlacementMode="Inline"/>
                            <TextBlock Grid.Row="2" Text="Default eraser width" Style="{StaticResource SubheadStyle}" VerticalAlignment="Center"/>
                            <NumberBox x:Name="EraserWidthBox" Grid.Row="2" Grid.Column="1" Width="140" Minimum="2" Maximum="80" Value="20" SpinButtonPlacementMode="Inline"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ─── Appearance & toolbar ────────────────────────────────── -->
                <Expander x:Name="AppearanceSection" Style="{StaticResource SectionExpanderStyle}"
                          Tag="appearance theme dark light system toolbar position size top bottom left right tools reorder hide export action buttons">
                    <Expander.Header>
                        <Grid ColumnSpacing="14" Padding="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xe99b;" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Appearance &amp; toolbar" Style="{StaticResource SubheadStyle}" /><TextBlock x:Name="AppearanceSummary" Text="Theme, toolbar position and which tools it shows" Style="{StaticResource RowHintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Theme" Style="{StaticResource SubheadStyle}" />
                                <TextBlock Text="Applies across the whole app when you save." Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="200" VerticalAlignment="Center">
                                <ComboBoxItem Content="Use system setting" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Toolbar position" Style="{StaticResource SubheadStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ToolbarPositionCombo" Grid.Column="1" Width="200">
                                <ComboBoxItem Content="Top" />
                                <ComboBoxItem Content="Bottom" />
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Right" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Toolbar size" Style="{StaticResource SubheadStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ToolbarSizeCombo" Grid.Column="1" Width="200">
                                <ComboBoxItem Content="Small" />
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="Large" />
                            </ComboBox>
                        </Grid>

                        <Border Background="{ThemeResource AppBorderBrush}" Height="1" />

                        <StackPanel Spacing="2">
                            <TextBlock Text="Drawing tools" Style="{StaticResource SubheadStyle}" />
                            <TextBlock Text="Drag rows to reorder. Unchecked tools are hidden but still work through keyboard shortcuts and stylus buttons."
                                       Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ListView x:Name="DrawingToolsList"
                                  CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                                  SelectionMode="None"
                                  ItemTemplate="{StaticResource ToolItemTemplate}"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource AppBorderBrush}"
                                  CornerRadius="8">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="8,2"/>
                                    <Setter Property="MinHeight" Value="44"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Action buttons" Style="{StaticResource SubheadStyle}" />
                            <TextBlock Text="These appear in the top title bar. Drag to change their order." Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ListView x:Name="ActionToolsList"
                                  CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                                  SelectionMode="None"
                                  ItemTemplate="{StaticResource ToolItemTemplate}"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource AppBorderBrush}"
                                  CornerRadius="8">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="8,2"/>
                                    <Setter Property="MinHeight" Value="44"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <CheckBox x:Name="ToolVisExport" Content="Show Export in the title bar (fixed position)" />
                    </StackPanel>
                </Expander>

                <!-- ─── Storage & autosave ──────────────────────────────────── -->
                <Expander x:Name="StorageSection" Style="{StaticResource SectionExpanderStyle}"
                          Tag="storage folder documents location autosave save delay seconds">
                    <Expander.Header>
                        <Grid ColumnSpacing="14" Padding="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xe2c7;" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Storage &amp; autosave" Style="{StaticResource SubheadStyle}" /><TextBlock x:Name="StorageSummary" Text="Where notes live and when they save" Style="{StaticResource RowHintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Notes folder" Style="{StaticResource SubheadStyle}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" IsReadOnly="True" />
                                <Button x:Name="PickFolderBtn" Grid.Column="1" Content="Choose…" CornerRadius="8" />
                            </Grid>
                        </StackPanel>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Autosave after (seconds)" Style="{StaticResource SubheadStyle}" />
                                <TextBlock Text="Turn autosave on with the Autosave tile. For PDFs this is a fast recovery save; the flattened pages other apps see refresh on a manual save or on close."
                                           Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="AutosaveDelayBox" Grid.Column="1" Width="140" Minimum="0.5" Maximum="120"
                                       SmallChange="0.5" LargeChange="5" VerticalAlignment="Center"
                                       SpinButtonPlacementMode="Inline" Value="2.5" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ─── Advanced: input diagnostics ─────────────────────────── -->
                <Expander x:Name="AdvancedSection" Style="{StaticResource SectionExpanderStyle}"
                          Tag="advanced diagnostics input devices mouse stylus eraser touch logs debug crash emulate tip">
                    <Expander.Header>
                        <Grid ColumnSpacing="14" Padding="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xe868;" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Advanced" Style="{StaticResource SubheadStyle}" /><TextBlock Text="Input diagnostics, logs and crash reports" Style="{StaticResource RowHintStyle}" /></StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Try out your devices in the area below. Indicators light up as the app receives events."
                                   Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Mouse" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="IndMouseInUse" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="In use"/></Border>
                                        <Border x:Name="IndMouseL" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Left"/></Border>
                                        <Border x:Name="IndMouseM" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Middle"/></Border>
                                        <Border x:Name="IndMouseR" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Right"/></Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Stylus" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="IndPenHover" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Hover"/></Border>
                                        <Border x:Name="IndPenTip" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Tip"/></Border>
                                        <Border x:Name="IndPenB1" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Button 1"/></Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Eraser" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="IndEraserHover" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Hover"/></Border>
                                        <Border x:Name="IndEraserTip" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Tip"/></Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Touch" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse x:Name="Touch1" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                        <Ellipse x:Name="Touch2" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                        <Ellipse x:Name="Touch3" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                        <Ellipse x:Name="Touch4" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                        <Ellipse x:Name="Touch5" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Last device used" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LastDeviceText" Text="(none yet)" Style="{StaticResource MutedStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    x:Name="Sandbox"
                                    Background="{ThemeResource AppSurfaceVariantBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Height="320"
                                    IsHitTestVisible="True">
                                <TextBlock Text="Tap, click, or draw here." Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ShowLogsBtn" Content="Show logs" CornerRadius="8"/>
                            <Button x:Name="ExportDebugBtn" Content="Export debug info" CornerRadius="8"/>
                            <Button x:Name="CrashLogBtn" Content="View crash log" CornerRadius="8"/>
                        </StackPanel>
                        <TextBlock Text="The log clears when you close and reopen Settings."
                                   Style="{StaticResource RowHintStyle}"/>
                        <CheckBox x:Name="EmulateTipBox" Content="Emulate stylus tip contact on button press"/>
                    </StackPanel>
                </Expander>

                <TextBlock x:Name="NoResultsText" Text="No settings match your search."
                           Style="{StaticResource MutedStyle}" HorizontalAlignment="Center"
                           Margin="0,24" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- ─── Save bar: only shown when something changed ──────────────── -->
        <Border x:Name="SaveBar" Grid.Row="2" Visibility="Collapsed"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Padding="32,12">
            <Grid x:Name="SaveBarContent" HorizontalAlignment="Center" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="You have unsaved changes" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="DiscardBtn" Grid.Column="1" Content="Discard" Padding="16,7" CornerRadius="10" />
                <Button x:Name="SaveBtn" Grid.Column="2" Content="Save" Padding="22,7" CornerRadius="10"
                        Background="{ThemeResource AppAccentBrush}" Foreground="White" BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Page>
