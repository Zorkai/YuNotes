<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YuNotes.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YuNotes.Controls"
    Background="{ThemeResource AppBackgroundBrush}">

    <!-- Sidebar layout: one category per page, picked from the list on the left.
         Every change applies right away (saved after a short pause) and shows a
         toast with Undo. Rows changed from their default show a dot and a Reset
         link, and the sidebar marks categories that contain changes. Search
         shows matching rows from every category at once. -->
    <Page.Resources>
        <DataTemplate x:Key="ToolItemTemplate">
            <Grid ColumnSpacing="12" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="18"
                          FontFamily="{StaticResource MaterialIconsFamily}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0"/>
            </Grid>
        </DataTemplate>

        <!-- Every icon on this page uses the app's Material Symbols font. -->
        <Style TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{StaticResource MaterialIconsFamily}" />
        </Style>

        <Style x:Key="RowHintStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedStyle}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="controls:SettingRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SettingRow">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" Background="Transparent">
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Ellipse x:Name="ModifiedDot" Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{ThemeResource AppAccentBrush}" Visibility="Collapsed"
                                                 ToolTipService.ToolTip="Changed from default" />
                                        <HyperlinkButton x:Name="ResetLink" Content="Reset" Padding="4,0" MinHeight="0"
                                                         FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"
                                                         Visibility="Collapsed" ToolTipService.ToolTip="Back to default" />
                                    </StackPanel>
                                    <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}"
                                               Style="{StaticResource RowHintStyle}" />
                                </StackPanel>
                                <ContentPresenter x:Name="SideHost" Grid.Column="1"
                                                  VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <ContentPresenter x:Name="BelowHost" Grid.Row="1" Grid.ColumnSpan="2"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A card of rows. The first row's top hairline is hidden in code. -->
        <Style x:Key="GroupCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="PanelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource H2Style}" />
        <Style x:Key="PanelSummaryStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>

        <Style x:Key="StepBarStyle" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="100" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="Background" Value="{ThemeResource AppBorderBrush}" />
        </Style>
        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        </Style>
        <Style x:Key="KeyCapStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppSurfaceVariantBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="NavItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 48 = Tall caption-button band height, so the header buttons share
                 a centerline with minimize/maximize/close. -->
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderGrid" Padding="12,0" VerticalAlignment="Center" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button x:Name="BackBtn" Style="{StaticResource ToolButtonStyle}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xe5c4;" />
                    </Button>
                    <TextBlock Text="Settings" Style="{StaticResource H2Style}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Window drag region. SetTitleBar turns this element's bounds into
                     non-client space (controls overlapping it lose input), so it only
                     covers the empty middle column. -->
                <Border x:Name="HeaderDragRegion" Grid.Column="1" Background="Transparent" Margin="0,-6" />
                <AutoSuggestBox x:Name="SettingsSearch" Grid.Column="2" Width="280"
                                PlaceholderText="Search settings (Ctrl+F)" QueryIcon="Find"
                                VerticalAlignment="Center" />
                <!-- Update status at a glance; opens the Updates page. -->
                <Button x:Name="UpdateChip" Grid.Column="3" CornerRadius="14" Padding="10,4"
                        VerticalAlignment="Center" BorderThickness="1"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        Background="{ThemeResource AppSurfaceVariantBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="UpdateChipIcon" Glyph="&#xe923;" FontSize="15" />
                        <TextBlock x:Name="UpdateChipText" Text="Updates" FontSize="{StaticResource FontSizeCaption}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─── Sidebar ───────────────────────────────────────────────── -->
            <Border Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="NavList" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource NavItemStyle}">
                        <ListViewItem Tag="pen">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xf604;" FontSize="18" /><TextBlock Grid.Column="1" Text="Pen and stylus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Ellipse x:Name="NavDotPen" Grid.Column="2" Width="7" Height="7" Fill="{ThemeResource AppAccentBrush}" Visibility="Collapsed" /></Grid>
                        </ListViewItem>
                        <ListViewItem Tag="touch">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xe913;" FontSize="18" /><TextBlock Grid.Column="1" Text="Touch and palm" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Ellipse x:Name="NavDotTouch" Grid.Column="2" Width="7" Height="7" Fill="{ThemeResource AppAccentBrush}" Visibility="Collapsed" /></Grid>
                        </ListViewItem>
                        <ListViewItem Tag="ink">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xe3b7;" FontSize="18" /><TextBlock Grid.Column="1" Text="Colors and widths" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Ellipse x:Name="NavDotInk" Grid.Column="2" Width="7" Height="7" Fill="{ThemeResource AppAccentBrush}" Visibility="Collapsed" /></Grid>
                        </ListViewItem>
                        <ListViewItem Tag="appearance">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xe99b;" FontSize="18" /><TextBlock Grid.Column="1" Text="Appearance" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Ellipse x:Name="NavDotAppearance" Grid.Column="2" Width="7" Height="7" Fill="{ThemeResource AppAccentBrush}" Visibility="Collapsed" /></Grid>
                        </ListViewItem>
                        <ListViewItem Tag="storage">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xe2c7;" FontSize="18" /><TextBlock Grid.Column="1" Text="Storage" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Ellipse x:Name="NavDotStorage" Grid.Column="2" Width="7" Height="7" Fill="{ThemeResource AppAccentBrush}" Visibility="Collapsed" /></Grid>
                        </ListViewItem>
                        <ListViewItem Tag="updates">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xe923;" FontSize="18" /><TextBlock Grid.Column="1" Text="Updates" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Ellipse x:Name="NavDotUpdates" Grid.Column="2" Width="7" Height="7" Fill="{ThemeResource AppAccentBrush}" Visibility="Collapsed" /></Grid>
                        </ListViewItem>
                        <ListViewItem Tag="shortcuts">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xe312;" FontSize="18" /><TextBlock Grid.Column="1" Text="Shortcuts" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></Grid>
                        </ListViewItem>
                        <ListViewItem Tag="diagnostics">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xe868;" FontSize="18" /><TextBlock Grid.Column="1" Text="Diagnostics" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Ellipse x:Name="NavDotDiagnostics" Grid.Column="2" Width="7" Height="7" Fill="{ThemeResource AppAccentBrush}" Visibility="Collapsed" /></Grid>
                        </ListViewItem>
                    </ListView>
                    <StackPanel x:Name="NavLegend" Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="12,8">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Changed from default" Style="{StaticResource RowHintStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── Category pages ────────────────────────────────────────── -->
            <!-- Spacing is a margin on the content, not ScrollViewer.Padding:
                 padding shrinks the viewport and clips the page bottom. -->
            <ScrollViewer x:Name="RootScroller" Grid.Column="1">
                <StackPanel x:Name="RootStack" Spacing="28" HorizontalAlignment="Center" Margin="32,24,32,96">

                    <!-- Pen and stylus -->
                    <StackPanel x:Name="PenPanel" Tag="pen" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Pen and stylus" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Name="PenSummary" Style="{StaticResource PanelSummaryStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <controls:SettingRow Title="Pressure sensitivity" SettingKey="pressure"
                                                     Description="Stroke width follows how hard you press."
                                                     Keywords="stylus pen pressure width">
                                    <ToggleSwitch x:Name="PressureToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                                <controls:SettingRow x:Name="CurveRow" Title="Pressure curve" SettingKey="curve" Stacked="True"
                                                     Description="Drag the handles to change how pressure turns into width. Draw in the test area to see where your pen lands on the curve."
                                                     Keywords="pressure curve soft firm natural preset test preview">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{ThemeResource AppSurfaceVariantBrush}"
                                                    BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                                                    CornerRadius="10" Height="190">
                                                <controls:PressureCurveEditor x:Name="CurveEditor" />
                                            </Border>
                                            <Border x:Name="PressureSandbox" Grid.Column="1"
                                                    Background="{ThemeResource AppSurfaceVariantBrush}"
                                                    BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                                                    CornerRadius="10" Height="190">
                                                <Grid>
                                                    <Canvas x:Name="PressureCanvas" IsHitTestVisible="False" />
                                                    <TextBlock x:Name="PressureHint" Text="Draw here with your pen"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}" IsHitTestVisible="False" />
                                                    <TextBlock x:Name="PressureReadout" Margin="10,6" FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}" IsHitTestVisible="False" />
                                                    <Button x:Name="PressureClearBtn" Content="Clear" Padding="10,2" CornerRadius="8"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <controls:ChoiceStrip x:Name="CurvePresets" />
                                            <TextBlock x:Name="CustomCurveText" Text="Custom curve" VerticalAlignment="Center"
                                                       Style="{StaticResource RowHintStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingRow>
                                <controls:SettingRow x:Name="MinPressureRow" Title="Lightest touch that draws" SettingKey="minpressure"
                                                     Description="Raise it if the pen leaves dots while it hovers."
                                                     Keywords="minimum pressure threshold ignore light touches sensitivity">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <StackPanel Width="200">
                                            <Slider x:Name="MinPressureSlider" Minimum="0" Maximum="4" StepFrequency="1" SnapsTo="StepValues"
                                                    TickFrequency="1" TickPlacement="Outside" IsThumbToolTipEnabled="False" />
                                            <Grid>
                                                <TextBlock Text="Feather" Style="{StaticResource RowHintStyle}" />
                                                <TextBlock Text="Very firm" Style="{StaticResource RowHintStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock x:Name="MinPressureLabel" Width="140" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </controls:SettingRow>
                                <controls:SettingRow x:Name="BoostRow" Title="Press for full width" SettingKey="boost"
                                                     Description="How hard you press to reach the thickest line."
                                                     Keywords="pressure multiplier boost">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <StackPanel Width="200">
                                            <Slider x:Name="PressureMultSlider" Minimum="0" Maximum="4" StepFrequency="1" SnapsTo="StepValues"
                                                    TickFrequency="1" TickPlacement="Outside" IsThumbToolTipEnabled="False" />
                                            <Grid>
                                                <TextBlock Text="Light press" Style="{StaticResource RowHintStyle}" />
                                                <TextBlock Text="Hard press" Style="{StaticResource RowHintStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock x:Name="PressureMultLabel" Width="140" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <controls:SettingRow x:Name="SmoothingRow" Title="Smoothing" SettingKey="smoothing"
                                                     Keywords="stabilizer jitter shaky smooth steady">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <Canvas x:Name="SmoothingPreview" Width="84" Height="28" VerticalAlignment="Center" />
                                        <controls:ChoiceStrip x:Name="SmoothingChoice" />
                                    </StackPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Barrel button" SettingKey="barrel"
                                                     Description="Switches tool while you hold it. The eraser tip always erases."
                                                     Keywords="pen button side button remap eraser">
                                    <ComboBox x:Name="BarrelCombo" Width="200" />
                                </controls:SettingRow>
                                <controls:SettingRow Title="Hold to snap" SettingKey="snap"
                                                     Description="Draw a shape and hold still for about 750 ms to turn it into a clean line, ellipse or rectangle."
                                                     Keywords="shape recognition snap line ellipse rectangle">
                                    <ToggleSwitch x:Name="HoldToSnapToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Touch and palm -->
                    <StackPanel x:Name="TouchPanel" Tag="touch" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Touch and palm" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Name="PalmSummary" Style="{StaticResource PanelSummaryStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <controls:SettingRow Title="Palm rejection" SettingKey="palm"
                                                     Description="Ignore your hand resting on the screen while you write."
                                                     Keywords="palm hand touch">
                                    <ToggleSwitch x:Name="PalmToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                                <controls:SettingRow x:Name="IgnoreTouchRow" Title="Ignore touch while the pen is near" SettingKey="ignoretouch"
                                                     Description="Finger input is dropped while the pen hovers over the screen."
                                                     Keywords="touch finger hover">
                                    <ToggleSwitch x:Name="IgnoreTouchToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                                <controls:SettingRow x:Name="GraceRow" Title="Palm block after the pen lifts" SettingKey="grace"
                                                     Keywords="grace period delay ms milliseconds palm block">
                                    <controls:ChoiceStrip x:Name="GraceChoice" />
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Colors and widths -->
                    <StackPanel x:Name="InkPanel" Tag="ink" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Colors and widths" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Name="InkSummary" Style="{StaticResource PanelSummaryStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <controls:SettingRow Title="Pen colors" SettingKey="pencolors" Stacked="True"
                                                     Description="Shown in the pen's color flyout. Click a color to edit it."
                                                     Keywords="preset palette color pen">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                                        <StackPanel x:Name="PenColorsPanel" Orientation="Horizontal" Spacing="8" Padding="2" />
                                    </ScrollViewer>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Highlighter colors" SettingKey="hicolors" Stacked="True"
                                                     Description="Shown in the highlighter's color flyout."
                                                     Keywords="preset palette color highlighter">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                                        <StackPanel x:Name="HighlighterColorsPanel" Orientation="Horizontal" Spacing="8" Padding="2" />
                                    </ScrollViewer>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <controls:SettingRow Title="Pen width" SettingKey="penwidth"
                                                     Description="Thickness new pen strokes start with."
                                                     Keywords="default width size thickness pen">
                                    <controls:ChoiceStrip x:Name="PenWidthChoice" />
                                </controls:SettingRow>
                                <controls:SettingRow Title="Highlighter width" SettingKey="hiwidth"
                                                     Description="Thickness new highlighter strokes start with."
                                                     Keywords="default width size thickness highlighter">
                                    <controls:ChoiceStrip x:Name="HighWidthChoice" />
                                </controls:SettingRow>
                                <controls:SettingRow Title="Eraser size" SettingKey="eraserwidth"
                                                     Description="Size of the eraser when you pick it."
                                                     Keywords="default width size eraser">
                                    <controls:ChoiceStrip x:Name="EraserWidthChoice" />
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel x:Name="AppearancePanel" Tag="appearance" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Name="AppearanceSummary" Style="{StaticResource PanelSummaryStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <controls:SettingRow Title="Theme" SettingKey="theme" Keywords="dark light system mode">
                                    <ComboBox x:Name="ThemeCombo" Width="200">
                                        <ComboBoxItem Content="Use system setting" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Liquid glass" SettingKey="glass"
                                                     Description="Draw the floating toolbar as refractive glass. Off uses plain acrylic."
                                                     Keywords="glass acrylic blur toolbar">
                                    <ToggleSwitch x:Name="LiquidGlassToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                                <controls:SettingRow Title="Seamless pages" SettingKey="seamless"
                                                     Description="No gap between pages."
                                                     Keywords="page gap continuous">
                                    <ToggleSwitch x:Name="SeamlessPagesToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                                <controls:SettingRow Title="Hide zoom bar" SettingKey="zoombar" Keywords="zoom bar editor">
                                    <ToggleSwitch x:Name="HideZoomBarToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <controls:SettingRow Title="Toolbar position" SettingKey="tbpos" Keywords="toolbar top bottom left right dock">
                                    <ComboBox x:Name="ToolbarPositionCombo" Width="200">
                                        <ComboBoxItem Content="Top" />
                                        <ComboBoxItem Content="Bottom" />
                                        <ComboBoxItem Content="Left" />
                                        <ComboBoxItem Content="Right" />
                                    </ComboBox>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Toolbar size" SettingKey="tbsize" Keywords="toolbar small normal large">
                                    <ComboBox x:Name="ToolbarSizeCombo" Width="200">
                                        <ComboBoxItem Content="Small" />
                                        <ComboBoxItem Content="Normal" />
                                        <ComboBoxItem Content="Large" />
                                    </ComboBox>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Drawing tools" SettingKey="drawtools" Stacked="True"
                                                     Description="Drag rows to reorder. Unchecked tools are hidden but still work through shortcuts and pen buttons."
                                                     Keywords="toolbar tools reorder hide pen highlighter eraser text image shape select hand">
                                    <ListView x:Name="DrawingToolsList"
                                              CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                                              SelectionMode="None" ItemTemplate="{StaticResource ToolItemTemplate}"
                                              BorderThickness="1" BorderBrush="{ThemeResource AppBorderBrush}" CornerRadius="8">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="8,2"/>
                                                <Setter Property="MinHeight" Value="44"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Action buttons" SettingKey="actiontools" Stacked="True"
                                                     Description="Shown in the title bar. Drag to change their order."
                                                     Keywords="title bar screenshot template pdf page actions">
                                    <ListView x:Name="ActionToolsList"
                                              CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                                              SelectionMode="None" ItemTemplate="{StaticResource ToolItemTemplate}"
                                              BorderThickness="1" BorderBrush="{ThemeResource AppBorderBrush}" CornerRadius="8">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="8,2"/>
                                                <Setter Property="MinHeight" Value="44"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Export button" SettingKey="export"
                                                     Description="Show Export in the title bar."
                                                     Keywords="export pdf png title bar">
                                    <ToggleSwitch x:Name="ExportToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Storage -->
                    <StackPanel x:Name="StoragePanel" Tag="storage" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Storage" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Name="StorageSummary" Style="{StaticResource PanelSummaryStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <!-- No SettingKey: the default depends on where Windows puts
                                     Documents (OneDrive or not), so "Reset" could point
                                     YuNotes at an empty folder. -->
                                <controls:SettingRow Title="Notes folder" Stacked="True"
                                                     Keywords="folder documents location path">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="FolderBox" IsReadOnly="True" />
                                        <Button x:Name="PickFolderBtn" Grid.Column="1" Content="Choose…" CornerRadius="8" />
                                    </Grid>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Autosave" SettingKey="autosave"
                                                     Description="Save automatically a short while after you stop drawing."
                                                     Keywords="autosave save automatic">
                                    <ToggleSwitch x:Name="AutosaveToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                                <controls:SettingRow x:Name="AutosaveDelayRow" Title="Autosave after" SettingKey="autosavedelay"
                                                     Description="Seconds. For PDFs this is a fast recovery save; the pages other apps see refresh when you save or close."
                                                     Keywords="autosave delay seconds">
                                    <NumberBox x:Name="AutosaveDelayBox" Width="140" Minimum="0.5" Maximum="120"
                                               SmallChange="0.5" LargeChange="5" SpinButtonPlacementMode="Inline" />
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Updates -->
                    <StackPanel x:Name="UpdatesPanel" Tag="updates" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Name="AppVersionText" Style="{StaticResource PanelSummaryStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <controls:SettingRow Title="Status" Stacked="True"
                                                     Keywords="update version download install check github">
                                    <Grid ColumnSpacing="22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="80" Height="80" VerticalAlignment="Center">
                                            <ProgressRing x:Name="UpdateRing" Width="80" Height="80"
                                                          IsIndeterminate="False" IsActive="True"
                                                          Minimum="0" Maximum="100" Value="0"
                                                          Foreground="{ThemeResource AppAccentBrush}"
                                                          Background="{ThemeResource AppAccentSoftBrush}" />
                                            <TextBlock x:Name="UpdatePercentText" FontSize="17" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                            <FontIcon x:Name="UpdateStateIcon" Glyph="&#xe923;" FontSize="28"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AppAccentBrush}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock x:Name="UpdateTitleText" Text="Updates" FontSize="{StaticResource FontSizeSubheading}"
                                                               FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button x:Name="CheckUpdatesBtn" Grid.Column="1" Content="Check for updates"
                                                        CornerRadius="8" VerticalAlignment="Top" />
                                            </Grid>
                                            <Grid x:Name="UpdateSteps" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="6">
                                                    <ProgressBar x:Name="StepCheckBar" Style="{StaticResource StepBarStyle}" />
                                                    <TextBlock x:Name="StepCheckLabel" Text="Check" Style="{StaticResource StepLabelStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <ProgressBar x:Name="StepDownloadBar" Style="{StaticResource StepBarStyle}" />
                                                    <TextBlock x:Name="StepDownloadLabel" Text="Download" Style="{StaticResource StepLabelStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="6">
                                                    <ProgressBar x:Name="StepStageBar" Style="{StaticResource StepBarStyle}" />
                                                    <TextBlock x:Name="StepStageLabel" Text="Prepare" Style="{StaticResource StepLabelStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Spacing="6">
                                                    <ProgressBar x:Name="StepReadyBar" Style="{StaticResource StepBarStyle}" />
                                                    <TextBlock x:Name="StepReadyLabel" Text="Ready" Style="{StaticResource StepLabelStyle}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="UpdateMetaText" FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Install updates automatically" SettingKey="autoupdate"
                                                     Description="Download new versions in the background and install them when you close YuNotes."
                                                     Keywords="auto update automatic background">
                                    <ToggleSwitch x:Name="AutoUpdateToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Shortcuts (read-only reference) -->
                    <StackPanel x:Name="ShortcutsPanel" Tag="shortcuts" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="Keyboard and pointer shortcuts in the editor." Style="{StaticResource PanelSummaryStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel x:Name="ShortcutRows" />
                        </Border>
                    </StackPanel>

                    <!-- Diagnostics -->
                    <StackPanel x:Name="DiagnosticsPanel" Tag="diagnostics" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Diagnostics" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="Check what YuNotes receives from your mouse, pen and touch screen." Style="{StaticResource PanelSummaryStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <controls:SettingRow Title="Input test" Stacked="True"
                                                     Description="Indicators light up as events arrive in the area on the right."
                                                     Keywords="diagnostics input devices mouse stylus eraser touch test">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Mouse" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border x:Name="IndMouseInUse" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="In use"/></Border>
                                                    <Border x:Name="IndMouseL" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Left"/></Border>
                                                    <Border x:Name="IndMouseM" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Middle"/></Border>
                                                    <Border x:Name="IndMouseR" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Right"/></Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Stylus" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border x:Name="IndPenHover" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Hover"/></Border>
                                                    <Border x:Name="IndPenTip" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Tip"/></Border>
                                                    <Border x:Name="IndPenB1" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Button 1"/></Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Eraser" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border x:Name="IndEraserHover" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Hover"/></Border>
                                                    <Border x:Name="IndEraserTip" Style="{StaticResource CardStyle}" Padding="8,4"><TextBlock Text="Tip"/></Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Touch" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse x:Name="Touch1" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                                    <Ellipse x:Name="Touch2" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                                    <Ellipse x:Name="Touch3" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                                    <Ellipse x:Name="Touch4" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                                    <Ellipse x:Name="Touch5" Width="14" Height="14" Fill="{ThemeResource AppBorderBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Last device used" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="LastDeviceText" Text="None yet" Style="{StaticResource MutedStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="Sandbox"
                                                Background="{ThemeResource AppSurfaceVariantBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                                                CornerRadius="12" Height="300" IsHitTestVisible="True">
                                            <TextBlock Text="Tap, click, or draw here." Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Border>
                                    </Grid>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Logs and crash reports"
                                                     Description="The pointer log clears when you close and reopen Settings."
                                                     Keywords="logs debug crash export">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ShowLogsBtn" Content="Show log" CornerRadius="8"/>
                                        <Button x:Name="ExportDebugBtn" Content="Export" CornerRadius="8"/>
                                        <Button x:Name="CrashLogBtn" Content="Crash log" CornerRadius="8"/>
                                    </StackPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Title="Emulate tip contact on button press" SettingKey="emulatetip"
                                                     Description="For pens that report a button press without touching the screen."
                                                     Keywords="emulate tip compatibility button">
                                    <ToggleSwitch x:Name="EmulateTipToggle" OnContent="" OffContent="" MinWidth="0" />
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="NoResultsText" Text="No settings match your search."
                               Style="{StaticResource MutedStyle}" HorizontalAlignment="Center"
                               Margin="0,24" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- ─── Undo toast ────────────────────────────────────────────── -->
            <Border x:Name="Toast" Grid.Column="1" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,24"
                    Background="{ThemeResource AppPopupCardBrush}" BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,8,8,8">
                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.18" /></Border.OpacityTransition>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xe5ca;" FontSize="16" Foreground="{ThemeResource AppSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center"
                               MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="UndoBtn" Content="Undo" Padding="12,4" CornerRadius="8" BorderThickness="0"
                            Background="Transparent" FontWeight="SemiBold"
                            Foreground="{ThemeResource AppAccentBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
