<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YuNotes.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             Sidebar
        ══════════════════════════════════════════════════════════════ -->
        <!-- Transparent over the window Mica (Windows 11 style) — an opaque
             surface here reads as a flat gray slab against the backdrop. -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Width="260"
                Background="Transparent"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Navigation items -->
                <StackPanel Grid.Row="0" Padding="8,8,8,4" Spacing="2">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <Button x:Name="AllNotesNavBtn"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="10,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="AllNotesIcon" Glyph="&#xe26c;" FontSize="18" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock x:Name="AllNotesLabel" Text="All notes"
                                       VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="TrashNavBtn"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="10,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xe872;" FontSize="18"
                                      Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Trash" VerticalAlignment="Center" FontSize="14"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ArchiveNavBtn"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="10,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xe149;" FontSize="18"
                                      FontFamily="{StaticResource MaterialIconsFamily}"
                                      Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Archive" VerticalAlignment="Center" FontSize="14"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Section divider -->
                    <Rectangle Height="1" Fill="{ThemeResource AppBorderBrush}"
                               Margin="4,8,4,4" />

                </StackPanel>

                <!-- Folder section — always visible -->
                <Grid x:Name="FolderSection" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- "Folders" header with a small + to create one -->
                    <Grid Grid.Row="0" Margin="18,2,12,2">
                        <TextBlock Text="Folders" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <Button x:Name="NewFolderBtn"
                                HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="6" Padding="6,4"
                                ToolTipService.ToolTip="New folder">
                            <FontIcon Glyph="&#xE145;" FontSize="18"
                                      FontFamily="{StaticResource MaterialIconsFamily}"
                                      Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <TreeView x:Name="FolderTree"
                              Grid.Row="1"
                              SelectionMode="Single"
                              Padding="4,2,4,8"
                              AllowDrop="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="MinHeight" Value="40" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <!-- Transparent background so hover fires across the whole row. -->
                                <Grid Padding="0,2,4,2" Background="Transparent"
                                      PointerEntered="FolderRow_PointerEntered"
                                      PointerExited="FolderRow_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                                Margin="-26,0,0,0">
                                        <FontIcon Glyph="{Binding Content.Glyph}" FontSize="18"
                                                  FontFamily="{StaticResource MaterialIconsFamily}"
                                                  Foreground="{Binding Content.ColorBrush}" />
                                        <TextBlock Text="{Binding Content.Name}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Note count, swapped for the ⋯ button while hovered. -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Content.CountText}"
                                               FontSize="12" Margin="0,0,8,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <Button Grid.Column="1"
                                            Click="FolderMoreBtn_Click"
                                            Opacity="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,2"
                                            CornerRadius="6"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Folder options">
                                        <FontIcon Glyph="&#xE5D3;" FontSize="18"
                                                  FontFamily="{StaticResource MaterialIconsFamily}"
                                                  Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>

                <!-- Bottom: Settings + warning indicator -->
                <Border Grid.Row="2"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6,8,12">
                    <Grid>
                        <Button x:Name="SettingsBtn"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="10,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xe8b8;" FontSize="18"
                                          Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="14"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <FontIcon x:Name="WarningIcon"
                                  Glyph="&#xe002;"
                                  FontSize="14"
                                  Foreground="#E8A428"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             Main content
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar: hamburger left, actions right -->
            <Border x:Name="HeaderBar" Grid.Row="0"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,0,12,0"
                    MinHeight="48">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Window drag region. SetTitleBar turns this element's bounds
                         into non-client space (controls overlapping it lose input),
                         so it only covers the empty column between search and actions. -->
                    <Border x:Name="HeaderDragRegion" Grid.Column="2"
                            Background="Transparent" Margin="0,-8" />

                    <!-- Left: sidebar toggle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="SidebarToggleBtn"
                                Style="{StaticResource ToolButtonStyle}"
                                ToolTipService.ToolTip="Toggle sidebar">
                            <FontIcon Glyph="&#xe5d2;" />
                        </Button>
                    </StackPanel>

                    <!-- Search: filters the visible notes by title or folder. -->
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Width="320"
                             Margin="8,0,8,0"
                             VerticalAlignment="Center"
                             PlaceholderText="Search notes (Ctrl+F)"
                             CornerRadius="8"
                             Padding="34,6,10,6" />
                    <FontIcon Grid.Column="1" Glyph="&#xE8B6;" FontSize="18"
                              FontFamily="{StaticResource MaterialIconsFamily}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="18,0,0,0" IsHitTestVisible="False"
                              Foreground="{ThemeResource AppTextSecondaryBrush}" />

                    <!-- Normal mode -->
                    <StackPanel x:Name="HeaderNormal"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="6">
                        <!-- Primary action in the app's own accent (soft tint + accent
                             text) rather than the system accent fill, so it matches the
                             rest of the chrome in both themes. -->
                        <Button x:Name="NewBtn"
                                Padding="12,8" CornerRadius="8" BorderThickness="1">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <StaticResource x:Key="ButtonBackground" ResourceKey="AppAccentSoftBrush" />
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AppAccentSoftBrush" />
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AppAccentSoftBrush" />
                                    <StaticResource x:Key="ButtonForeground" ResourceKey="AppAccentBrush" />
                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AppAccentBrush" />
                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AppAccentBrush" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AppAccentBrush" />
                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AppAccentBrush" />
                                </ResourceDictionary>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xe145;" FontSize="18"
                                          FontFamily="{StaticResource MaterialIconsFamily}" />
                                <TextBlock Text="New note" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenBtn"
                                Padding="12,8" CornerRadius="8"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xe415;" FontSize="18" />
                                <TextBlock Text="Import PDF" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SelectBtn"
                                Padding="12,8" CornerRadius="8"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Select notes">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xe162;" FontSize="18" />
                                <TextBlock Text="Select" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Select mode -->
                    <StackPanel x:Name="HeaderSelect"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBlock x:Name="SelectionCountLabel" Text="0 selected"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Style="{StaticResource MutedStyle}" />
                        <Button x:Name="RestoreBtn"
                                Padding="12,8" CornerRadius="8"
                                Background="Transparent" BorderThickness="0"
                                IsEnabled="False" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;" FontSize="18" />
                                <TextBlock Text="Restore" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UnarchiveBtn"
                                Padding="12,8" CornerRadius="8"
                                Background="Transparent" BorderThickness="0"
                                IsEnabled="False" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xe169;" FontSize="18"
                                          FontFamily="{StaticResource MaterialIconsFamily}" />
                                <TextBlock Text="Unarchive" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoveToFolderBtn"
                                Padding="12,8" CornerRadius="8"
                                Background="Transparent" BorderThickness="0" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xe2c8;" FontSize="18" />
                                <TextBlock Text="Move to" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ArchiveBtn"
                                Padding="12,8" CornerRadius="8"
                                Background="Transparent" BorderThickness="0" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xe149;" FontSize="18"
                                          FontFamily="{StaticResource MaterialIconsFamily}" />
                                <TextBlock Text="Archive" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteBtn"
                                Padding="12,8" CornerRadius="8"
                                Background="#E03A3A" Foreground="White"
                                BorderThickness="0" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xe872;" FontSize="18" />
                                <TextBlock x:Name="DeleteBtnLabel" Text="Move to Trash" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelSelectBtn"
                                Padding="12,8" CornerRadius="8">
                            <TextBlock Text="Cancel" FontSize="14" />
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Notes area -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Shown once an update has been downloaded and staged. -->
                <InfoBar x:Name="UpdateInfoBar"
                         Grid.Row="0"
                         Margin="24,12,24,0"
                         Severity="Success"
                         Title="Update ready"
                         IsOpen="False" />

                <!-- Section header: title + sort bar -->
                <Grid Grid.Row="1" Padding="24,18,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SectionTitle" Text="All notes"
                               Style="{StaticResource H1Style}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{ThemeResource AppSurfaceVariantBrush}"
                                CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <!-- Clicking the active option flips the direction; the
                                     arrow (shown only on the active one) says which way. -->
                                <Button x:Name="SortByDateBtn" Padding="12,6" CornerRadius="6"
                                        Background="{ThemeResource AppSurfaceBrush}" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Date" FontSize="13" VerticalAlignment="Center" />
                                        <FontIcon x:Name="SortDateArrow" FontSize="14"
                                                  FontFamily="{StaticResource MaterialIconsFamily}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SortByNameBtn" Padding="12,6" CornerRadius="6"
                                        Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Name" FontSize="13" VerticalAlignment="Center" />
                                        <FontIcon x:Name="SortNameArrow" FontSize="14"
                                                  FontFamily="{StaticResource MaterialIconsFamily}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SortByFolderBtn" Padding="12,6" CornerRadius="6"
                                        Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Folder" FontSize="13" VerticalAlignment="Center" />
                                        <FontIcon x:Name="SortFolderArrow" FontSize="14"
                                                  FontFamily="{StaticResource MaterialIconsFamily}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Content: empty hint + notes grid -->
                <Grid Grid.Row="2">

                    <!-- Empty state (hidden when notes exist) -->
                    <StackPanel x:Name="EmptyHint"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="6"
                                Visibility="Collapsed">
                        <TextBlock x:Name="EmptyHintTitle" Text="No notes"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="EmptyHintSubtitle" Text="Tap New note to add one."
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   Opacity="0.55" />
                    </StackPanel>

                    <!-- Notes grid -->
                    <ScrollViewer Padding="24,12,24,24">
                        <GridView x:Name="RecentList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  CanDragItems="True"
                                  IsMultiSelectCheckBoxEnabled="False"
                                  ItemContainerStyle="{StaticResource NoteCardContainerStyle}"
                                  ItemClick="RecentList_ItemClick">
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                                </TransitionCollection>
                            </GridView.ItemContainerTransitions>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <!-- Transparent (not null) background: the "New..." card's
                                         dashed rectangle has no fill, so without this the card
                                         interior is a hit-test hole and hover only fires on the
                                         icon/text. -->
                                    <Grid Width="176" Height="262" Background="Transparent">

                                        <!-- Regular note card -->
                                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Visibility="{Binding NormalCardVisibility}"
                                                PointerEntered="Card_PointerEntered"
                                                PointerExited="Card_PointerExited">
                                            <Border.Shadow>
                                                <ThemeShadow />
                                            </Border.Shadow>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Page preview: fills the card, page count in the corner. -->
                                                <Grid Grid.Row="0" Padding="10,12,10,4">
                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            CornerRadius="3"
                                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                                            BorderThickness="1"
                                                            Background="White">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,4,4" Padding="6,1"
                                                            CornerRadius="4"
                                                            Background="{ThemeResource AppSurfaceVariantBrush}"
                                                            Visibility="{Binding PageBadgeVisibility}">
                                                        <TextBlock Text="{Binding PageCount}" FontSize="11"
                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    </Border>
                                                </Grid>

                                                <StackPanel Grid.Row="1"
                                                            Padding="10,4,10,10"
                                                            Spacing="2">
                                                    <TextBlock FontWeight="SemiBold"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Title}" /><Run Text="{Binding TitleHint}"
                                                             FontWeight="Normal"
                                                             Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE415;" FontSize="13"
                                                                  FontFamily="{StaticResource MaterialIconsFamily}"
                                                                  Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                  Visibility="{Binding PdfIconVisibility}"
                                                                  ToolTipService.ToolTip="Imported PDF" />
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   FontSize="11"
                                                                   Style="{StaticResource MutedStyle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <!-- Folder chip: colored for a folder, muted "No folder" otherwise. -->
                                                    <Border HorizontalAlignment="Left" Margin="0,3,0,0"
                                                            Padding="6,1,7,2" CornerRadius="6"
                                                            Background="{Binding FolderChipBrush}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="{Binding FolderGlyph}" FontSize="12"
                                                                      FontFamily="{StaticResource MaterialIconsFamily}"
                                                                      Foreground="{Binding FolderTextBrush}" />
                                                            <TextBlock Text="{Binding FolderDisplay}" FontSize="11"
                                                                       MaxWidth="128"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{Binding FolderTextBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- "New note" card: one quiet dashed outline with a + and label. -->
                                        <Grid Visibility="{Binding NewCardVisibility}">
                                            <Rectangle Stroke="{ThemeResource AppTextSecondaryBrush}"
                                                       StrokeThickness="1"
                                                       StrokeDashArray="4,3"
                                                       RadiusX="14" RadiusY="14"
                                                       Opacity="0.35" />
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Spacing="4">
                                                <FontIcon Glyph="&#xE145;"
                                                          FontFamily="{StaticResource MaterialIconsFamily}"
                                                          FontSize="24"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="New note"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
